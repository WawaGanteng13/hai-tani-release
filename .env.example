# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_VERIFY_TOKEN: Token used to verify incoming Webhook requests from Meta WhatsApp Cloud API.
WHATSAPP_VERIFY_TOKEN="tani_ai_webhook_verify_token"

# GOOGLE_SHEETS_ID: Optional default Google Sheet ID to store farmer data.
GOOGLE_SHEETS_ID=""

# GOOGLE_SERVICE_ACCOUNT_FILE: path file JSON service account GCP untuk cermin
# Sheets write-behind (bot -> Sheets, async, tak memengaruhi kecepatan chat).
# Simpan di data/gcp-service-account.json (di-gitignore). Alternatif: isi
# GOOGLE_SERVICE_ACCOUNT_JSON dengan seluruh isi JSON satu-baris.
GOOGLE_SERVICE_ACCOUNT_FILE=""
GOOGLE_SERVICE_ACCOUNT_JSON=""

# GOOGLE_DRIVE_SHEETS_API_KEY: Server-side API key / token for accessing Google Drive & Sheets.
# Kept securely on the backend server, never exposed to client-side browsers.
GOOGLE_DRIVE_SHEETS_API_KEY=""

# 9ROUTER_URL: URL of 9Router AI Gateway (e.g. http://localhost:20128 or remote gateway).
# Provides OpenAI-compatible endpoints (/v1/chat/completions) with auto-fallback.
NINEROUTER_URL=""

# NINEROUTER_KEY: API key for 9Router if requireApiKey is enabled in 9Router Dashboard.
NINEROUTER_KEY=""

# NINEROUTER_MODEL: Default model ID to route via 9Router (e.g. openai/gpt-4o, gemini-2.5-flash, vip combo).
NINEROUTER_MODEL="openai/gpt-4o"

# LAYA_URL: Intent sidecar laya (python laya_sidecar.py). Opt-in; kosongkan = regex saja.
LAYA_URL=""
# LAYA_PYTHON: Interpreter untuk sidecar (default Windows: python, lalu python3).
LAYA_PYTHON=""

# META_MODEL_URL: Base URL Meta Model API (OpenAI-compatible). Default https://api.meta.ai/v1.
META_MODEL_URL="https://api.meta.ai/v1"

# META_MODEL_KEY: API key Meta Model API (format LLM|id|secret). Kosongkan = provider Meta nonaktif.
META_MODEL_KEY=""

# META_MODEL_MODEL: Default model Meta (mis. muse-spark-1.3, muse-wonder-1.0).
META_MODEL_MODEL="muse-spark-1.3"

# NVIDIA NIM: kaki cadangan OpenAI-compatible (https://build.nvidia.com).
# Model default z-ai/glm-5.3-flash (gratis s.d. 40 RPM, multimodal teks+gambar).
# Kosongkan NVIDIA_NIM_KEY = provider NIM nonaktif (chain tetap jalan).
NVIDIA_NIM_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_KEY=""
NVIDIA_NIM_MODEL="z-ai/glm-5.3-flash"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API Key for interactive map display & marker geolocation.
VITE_GOOGLE_MAPS_API_KEY=""

# APPS_SCRIPT_SECRET: bila diisi, POST /api/webhook wajib menyertakan secret yang sama
# (header x-apps-script-secret atau body appsScriptSecret). Kosong = jembatan terbuka.
APPS_SCRIPT_SECRET=""

# WHATSAPP_ACCESS_TOKEN: token System User permanen (Graph API) untuk kirim pesan WA.
# Dibuat di dashboard Meta bisnis; JANGAN commit nilai aslinya.
# CATAT: forwarder Vercel (api/webhook/whatsapp.ts) memakai nama ENV BERBEDA
# untuk nilai token yang SAMA: WHATSAPP_TOKEN. Isi keduanya dengan token identik.
WHATSAPP_ACCESS_TOKEN=""

# PHONE_NUMBER_ID: id nomor bisnis pengirim (lihat WhatsApp > API Setup).
# Default kode = 1345016292036690 (+62 881-0261-39498); isi bila nomor berganti.
PHONE_NUMBER_ID=""

# FORWARD_SECRET: secret bersama forwarder Vercel -> backend (header x-tani-forward-secret).
# Wajib sama di .env backend dan env Vercel.
FORWARD_SECRET=""

# WHATSAPP_APP_SECRET: App Secret aplikasi Meta (WhatsApp > API Setup) untuk
# verifikasi X-Hub-Signature-256. Wajib sama di backend dan env Vercel.
WHATSAPP_APP_SECRET=""

# KARTU_PUBLIC_BASE: basis URL publik untuk tautan kartu WA (cth. URL ngrok aktif).
# Kosong = otomatis baca pub= dari hai-tani-ops/last-status.txt, lalu host request.
KARTU_PUBLIC_BASE=""

